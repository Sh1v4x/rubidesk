{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rubidesk",
  "version": "0.4.0",
  "identifier": "ai.landcapital.rubilax",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Rubidesk",
        "width": 340,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3OUVGM0E0NEMxRDc5OTEKUldTUmVSMU1wUE9lNTlFSDY4a0k0KzlEVWltOVRuMmowRWcrYkFoOU1PTVZ0M3JXWFR0Z1UzTUsK",
      "endpoints": [
        "https://github.com/Sh1v4x/rubidesk/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
